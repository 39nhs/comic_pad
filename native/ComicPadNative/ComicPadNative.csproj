<Project Sdk="Microsoft.NET.Sdk">
  <!-- ComicPad 네이티브 앱 시제품 (네이티브_재작성_계획.md 의 단계 0). 외부 패키지 없이 .NET 8 + WinForms 창 + 직접 짠 그리기 엔진 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\ComicPad.ico</ApplicationIcon>
    <AssemblyName>ComicPadNative</AssemblyName>
    <RootNamespace>ComicPadNative</RootNamespace>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- AI 기능 (선화·따기·깊이·키우기·AI 고르기): 마이크로소프트 ONNX Runtime, 그래픽 가속(DirectML) 포함 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
  </ItemGroup>
</Project>
